---
import Gallery from '../components/Gallery';
import { site } from '../data/works';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.title}</title>
    <meta name="description" content={`${site.artist}: painting, sculpture and stained glass.`} />
    <meta name="theme-color" content="#120c07" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Gallery client:only="react" />
    <noscript>
      <p style="padding:2rem;text-align:center">{site.title}. This gallery needs JavaScript to open.</p>
    </noscript>
  </body>
</html>
